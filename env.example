# Copy to local/.env (gitignored) and adjust. The justfile loads it automatically.
# Values shown are the defaults.

# Vector's address (mDNS name or IP) and the SSH key for him
VECTOR_HOST=Vector.local
# use an absolute path (no ~ expansion in .env files)
VECTOR_KEY=/home/you/.ssh/vector_private_key

# Container engine for wire-pod
CONTAINER_ENGINE=podman

# wire-pod's web UI port (the robot only needs 80 and 443); change if 8080 is taken
WIREPOD_WEB_PORT=8080

# LLM for wire-pod (any OpenAI-compatible endpoint). Default: `just llm-install` (llama.cpp).
# For Ollama on a desktop: LLM_MODEL=qwen2.5:7b, LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=small
LLM_ENDPOINT=http://127.0.0.1:8085/v1
# Where `just llm-install` keeps the model file
LLM_MODELS_DIR=/srv/models

# Server install (docs/06): wire-pod as a systemd service. Set WIREPOD_SYSTEMD=true there,
# so start/stop/restart/logs use systemctl.
WIREPOD_SYSTEMD=false
WIREPOD_DIR=/srv/wire-pod

# Tailscale version to install on Vector
TS_VERSION=1.104.5
# The wire-pod server's MagicDNS name and tailnet IP (for Vector's hosts file; docs/06)
SERVER_TS_NAME=<host>.<tailnet>.ts.net
SERVER_TS_IP=100.x.y.z
